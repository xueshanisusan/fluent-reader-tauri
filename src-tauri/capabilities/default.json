{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capabilities: store + scoped shell open for article links.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "store:default",
    "notification:default",
    {
      "identifier": "shell:allow-open",
      "allow": [
        { "url": "https://**" },
        { "url": "http://**" }
      ]
    }
  ]
}
