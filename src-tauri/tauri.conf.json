{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Fluent Reader (Tauri Spike)",
  "version": "0.0.1",
  "identifier": "me.hyliu.fluentreader.spike",
  "build": {
    "frontendDist": "../dist",
    "devUrl": null,
    "beforeDevCommand": null,
    "beforeBuildCommand": null
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Fluent Reader (Tauri Spike)",
        "width": 1200,
        "height": 700,
        "minWidth": 992,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ]
  }
}
